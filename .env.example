APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
DATA_DIR=/app/data
PUBLIC_BASE_URL=https://your-domain.example

# The daily job starts early and catches up on service startup after 06:30.
APP_TIMEZONE=Asia/Shanghai
DAILY_UPDATE_START=06:30
ENABLE_SCHEDULER=true
RUNNING_JOB_STALE_MINUTES=180

# AI provider. Without a provider key, the app uses the built-in rule engine so
# the full workflow still runs for demos and smoke tests.
AI_PROVIDER=deepseek
AI_MULTI_AGENT=true
USE_DEEPSEEK_AI=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
DEEPSEEK_PRO_SCORE_THRESHOLD=84
DEEPSEEK_FORCE_PRO=false
DEEPSEEK_TIMEOUT_SECONDS=60
CRAWL_LINKS_PER_SOURCE=6
MAX_ARTICLES_PER_RUN=48
MAX_AI_ARTICLES_PER_RUN=16
MIN_RELEVANCE_SCORE=50
MIN_OPPORTUNITY_SCORE=65
MIN_BREAKOUT_SCORE=65
ENFORCE_COVERAGE_DATE=true
HTTP_TIMEOUT_SECONDS=10

# Internet search. Pick one provider and set the matching key. If no search key
# is configured, the web_search source falls back to Google News RSS keyword
# searches so the workflow still runs.
SEARCH_PROVIDER=
SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
SERPAPI_API_KEY=
BRAVE_SEARCH_API_KEY=
BING_SEARCH_API_KEY=
SEARCH_QUERIES=
SEARCH_MAX_QUERIES_PER_RUN=8
SEARCH_RESULTS_PER_QUERY=6
SEARCH_RESULTS_PER_SOURCE=36
SEARCH_FETCH_ARTICLE_CONTENT=true
SEARCH_CONTENT_FETCH_LIMIT=24
SEARCH_TIME_RANGE=month
SEARCH_SOURCE_TIME_BUDGET_SECONDS=45
SEARCH_MAX_QUERY_FAILURES=3
SEARCH_MAX_CONTENT_FAILURES=8

# Optional OpenAI fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
USE_OPENAI_AI=false

# Keep true for first-run demos. Set false when your live sources are stable.
USE_SAMPLE_DATA=true
